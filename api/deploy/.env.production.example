# Copy to .env on the server and fill in. Never commit the real file (it is git-ignored).
# Names match the API's configuration; "__" in an environment variable means ":" in appsettings.

# --- Database ---------------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=
# docker-compose.prod.yml builds ConnectionStrings__MolBhav from the password above.

# --- API identity -----------------------------------------------------------------------------------------------
# At least 32 bytes of random text. Changing it signs every user out.
Jwt__SigningKey=
# Must match the public API address.
Jwt__Issuer=https://molbhav-api.jagtech.in
Jwt__Audience=molbhav-mobile

# --- Behind Nginx -----------------------------------------------------------------------------------------------
# The IP Nginx connects from (127.0.0.1 when Nginx runs on the same host; the Docker bridge gateway otherwise).
ReverseProxy__KnownProxies__0=
# Only the web origins that really call the API (https only). Leave empty for mobile-app-only use.
# Cors__AllowedOrigins__0=https://admin.example.in

# --- Price feed -------------------------------------------------------------------------------------------------
Agmarknet__ApiKey=

# --- Payments (Razorpay) ----------------------------------------------------------------------------------------
Billing__Razorpay__KeyId=
Billing__Razorpay__KeySecret=
Billing__Razorpay__WebhookSecret=

# --- Sign-in ----------------------------------------------------------------------------------------------------
Authentication__Google__Enabled=true
Authentication__Google__ServerClientId=
# SMS codes stay off until the DLT template exists (Authentication__LoginMethods__Otp=false is the default).
# OtpDelivery__Provider=Msg91
# OtpDelivery__Msg91__AuthKey=
# OtpDelivery__Msg91__TemplateId=

# --- Notifications ----------------------------------------------------------------------------------------------
# The whole service-account JSON as one line.
Push__Fcm__ServiceAccountJson=
Push__WhatsApp__AccessToken=
Push__WhatsApp__PhoneNumberId=
Push__WhatsApp__TemplateName=
Push__WhatsApp__TemplateLanguage=en_US

# --- Weather (optional until IMD access exists) -----------------------------------------------------------------
# Imd__ApiKey=

# --- Support contacts shown in the app ---------------------------------------------------------------------------
Support__Email=
Support__Phone=
Support__WhatsAppNumber=
