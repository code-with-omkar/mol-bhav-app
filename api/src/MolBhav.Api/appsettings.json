{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "MolBhav.Api" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MolBhav": ""
  },
  "Database": {
    "MaxRetryCount": 3,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "Jwt": {
    "Issuer": "https://api.molbhav.in",
    "Audience": "molbhav-mobile",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "ClockSkewSeconds": 30
  },
  "Localization": {
    "DefaultLanguage": "en",
    "SupportedLanguages": [ "en", "hi", "mr", "gu", "ta", "te", "kn" ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthenticatedPermitLimit": 120,
    "AnonymousPermitLimit": 30,
    "WindowSeconds": 60,
    "OtpPermitLimit": 5,
    "OtpVerifyPermitLimit": 15,
    "OtpWindowSeconds": 600
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Outbox": {
    "Enabled": true,
    "PollingIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 5
  }
}
