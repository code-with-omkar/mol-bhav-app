{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "MolBhav.Api"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MolBhav": ""
  },
  "Database": {
    "MaxRetryCount": 3,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "Jwt": {
    "Issuer": "https://api.molbhav.in",
    "Audience": "molbhav-mobile",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "ClockSkewSeconds": 30
  },
  "Authentication": {
    "LoginMethods": {
      "Otp": false,
      "Password": true,
      "AllowClaimingPasswordlessAccounts": false
    }
  },
  "Localization": {
    "DefaultLanguage": "en",
    "SupportedLanguages": [
      "en",
      "hi",
      "mr",
      "gu",
      "ta",
      "te",
      "kn"
    ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Support": {
    "WhatsAppNumber": "",
    "Phone": "",
    "Email": ""
  },
  "RateLimiting": {
    "AuthenticatedPermitLimit": 120,
    "AnonymousPermitLimit": 30,
    "WindowSeconds": 60,
    "OtpPermitLimit": 5,
    "OtpVerifyPermitLimit": 15,
    "OtpWindowSeconds": 600,
    "PasswordLoginPermitLimit": 20
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Outbox": {
    "Enabled": true,
    "PollingIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 5
  },
  "WebhookInbox": {
    "Enabled": true,
    "PollingIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxAttempts": 10,
    "BaseRetryDelaySeconds": 30,
    "MaxRetryDelaySeconds": 3600,
    "RetentionDays": 90
  },
  "OpsAlerts": {
    "SlackWebhookUrl": "",
    "EnvironmentLabel": "MolBhav"
  },
  "PaymentReconciliation": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "MinAgeMinutes": 10,
    "MaxAgeHours": 24,
    "BatchSize": 100
  },
  "IngestionScheduler": {
    "Enabled": true,
    "IntervalHours": 24
  },
  "SubscriptionExpiry": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "BatchSize": 200
  },
  "Agmarknet": {
    "ApiKey": "",
    "PageSize": 500,
    "ThrottleDelayMs": 250,
    "RequestTimeoutSeconds": 30,
    "MarketCodeMap": {
      "pune": "apmc-pune"
    },
    "CommodityCodeMap": {
      "jowar-sorghum": "jowar",
      "bajra-pearl-millet-cumbu": "bajra",
      "arhar-tur-red-gram-whole": "tur",
      "bengal-gram-gram-whole": "chana",
      "green-gram-moong-whole": "moong",
      "black-gram-urd-beans-whole": "urad"
    }
  }
}
