POST {{host}}/api/v1/procurement/requirements
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "{{products.response.body.$.data[0].id}}",
  "unitId": "{{products.response.body.$.data[0].defaultUnit.id}}",
  "quantity": 50,
  "targetPrice": 1900
}

