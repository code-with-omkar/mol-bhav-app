{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Database": {
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true
  },
  "Jwt": {
    "Issuer": "https://localhost:7040",
    "Audience": "molbhav-mobile-dev"
  },
  "RateLimiting": {
    "AuthenticatedPermitLimit": 1000,
    "AnonymousPermitLimit": 1000
  },
  "OtpDelivery": {
    "Provider": "Log"
  },
  "Agmarknet": {
    "UseMockData": true
  },
  "Cors": {
    "AllowAnyLocalhostPort": true
  },
  "Support": {
    "WhatsAppNumber": "+919000000000",
    "Phone": "+91 90000 00000",
    "Email": "support@jagtech.in"
  }
}
